# Static Podman bundle: podman, conmon, crun, runc, netavark, aardvark-dns, catatonit, passt/pasta
# https://github.com/mgoltzsche/podman-static/releases
PODMAN_STATIC_VERSION="6.1.2"
PODMAN_STATIC_URL="https://github.com/mgoltzsche/podman-static/releases/download/v${PODMAN_STATIC_VERSION}/podman-linux-amd64.tar.gz"

# Prometheus exporter for podman (v2.x <-> podman v6), built from source (vendored Go modules) in local/cgo mode
# https://github.com/containers/prometheus-podman-exporter/releases
PODMAN_EXPORTER_VERSION="2.0.0"
PODMAN_EXPORTER_URL="https://github.com/containers/prometheus-podman-exporter/archive/refs/tags/v${PODMAN_EXPORTER_VERSION}.tar.gz"
