#!/usr/bin/env bash
set -euo pipefail

LOG_DIR=/var/vcap/sys/log/pods
mkdir -p "$LOG_DIR"

SCRIPT_NAME=$(basename "$0")
exec 1>> "${LOG_DIR}/${SCRIPT_NAME}.stdout.log"
exec 2>> "${LOG_DIR}/${SCRIPT_NAME}.stderr.log"
source /var/vcap/packages/common/script_utils.sh

log_info "--- ${SCRIPT_NAME} begin"

if [[ ! -f /var/vcap/jobs/podman/bin/podman-env.sh ]]; then
  log_error "the pods job requires the podman job on the same instance group"
  exit 1
fi
source /var/vcap/jobs/pods/bin/pods-env.sh

<%
  require 'yaml'
  require 'base64'
  require 'shellwords'
  require 'ipaddr'

  pod_kinds = %w(Pod Deployment DaemonSet)
  supported_kinds = pod_kinds + %w(ConfigMap Secret PersistentVolumeClaim)

  bash_array = lambda { |values| "(" + Array(values).map { |v| Shellwords.escape(v.to_s) }.join(" ") + ")" }
  setting = lambda { |definition, key| definition.key?(key) ? definition[key] : p("pods.defaults.#{key}") }

  # egress: nftables script loaded by the supervisor into each pod's network namespace before its containers
  # start. Only the listed destinations, loopback, replies (e.g. to clients of a hostPort) and IPv6 neighbor
  # discovery leave the pod; the dns sets are filled at runtime from the pod's resolv.conf.
  # A container able to bypass the rules (NET_ADMIN flushes them, NET_RAW sends packets around them) is rejected.
  bypass_caps = %w(NET_ADMIN NET_RAW SYS_ADMIN ALL)
  # connection log: dynamic sets keyed by destination . protocol . port (other protocols: without the port) with a
  # counter per element; every poll the supervisor moves them into egress.log (bin/egress-log.awk) and empties them
  log_levels = { "none" => [], "blocked" => %w(blocked), "all" => %w(allowed blocked) }
  log_set_size = 4096
  log_families = [["4", "ip", "ipv4_addr"], ["6", "ip6", "ipv6_addr"]]
  log_record = lambda do |verdict|
    log_families.flat_map do |family, address, _type|
      ["meta nfproto ipv#{family} meta l4proto { tcp, udp } add @#{verdict}#{family} { #{address} daddr . meta l4proto . th dport counter }",
       "meta nfproto ipv#{family} meta l4proto != { tcp, udp } add @#{verdict}#{family}_noport { #{address} daddr . meta l4proto counter }"]
    end
  end
  egress_rules = lambda do |where, egress, documents, play_flags|
    raise "#{where}: must be a hash (allow, dns, log)" unless egress.is_a?(Hash)
    unknown = egress.keys.map(&:to_s) - %w(allow dns log)
    raise "#{where}: unknown key(s) #{unknown.join(", ")}" unless unknown.empty?
    raise "#{where}.allow: must be a list" unless egress["allow"].nil? || egress["allow"].is_a?(Array)
    raise "#{where}.dns: must be true or false" unless [nil, true, false].include?(egress["dns"])
    log = (egress.key?("log") ? egress["log"] : p("pods.defaults.egress_log")).to_s
    raise "#{where}.log: \"#{log}\" is not #{log_levels.keys.join(", ")}" unless log_levels.key?(log)
    logged = log_levels[log]

    documents.select { |doc| pod_kinds.include?(doc["kind"]) }.each do |doc|
      object = "#{doc["kind"]}/#{doc["metadata"]["name"]}"
      spec = (doc["kind"] == "Pod" ? doc["spec"] : doc.dig("spec", "template", "spec")) || {}
      raise "#{where}: #{object} uses hostNetwork, egress needs the pod's own network namespace" if spec["hostNetwork"]
      (Array(spec["initContainers"]) + Array(spec["containers"])).each do |container|
        context = container["securityContext"] || {}
        raise "#{where}: #{object} container #{container["name"]} is privileged, it could bypass the egress rules" if context["privileged"]
        caps = Array(context.dig("capabilities", "add")).map { |cap| cap.to_s.upcase.delete_prefix("CAP_") } & bypass_caps
        raise "#{where}: #{object} container #{container["name"]} adds #{caps.join(", ")}, it could bypass the egress rules" unless caps.empty?
      end
    end
    flags = Array(play_flags).map(&:to_s)
    flags.each_with_index do |flag, i|
      network = flag[/\A--net(?:work)?=(.*)\z/, 1] || (%w(--net --network).include?(flag) ? flags[i + 1].to_s : nil)
      raise "#{where}: play_flags use the network '#{network}', egress needs the pods' own network namespace" if
        network && (network == "host" || network.start_with?("ns:", "container:"))
    end

    rules = Array(egress["allow"]).each_with_index.map do |entry, i|
      at = "#{where}.allow[#{i}]"
      raise "#{at}: must be a hash (to, protocol, port/ports)" unless entry.is_a?(Hash)
      unknown = entry.keys.map(&:to_s) - %w(to protocol port ports)
      raise "#{at}: unknown key(s) #{unknown.join(", ")}" unless unknown.empty?
      to = begin
        raise IPAddr::InvalidAddressError if entry["to"].to_s.include?("%") # zone ids (fe80::1%eth0): not for nft
        IPAddr.new(entry["to"].to_s)
      rescue IPAddr::Error
        raise "#{at}.to: \"#{entry["to"]}\" is not an IP address or CIDR (host names are not resolved)"
      end
      daddr = (to.ipv4? ? "ip" : "ip6") + " daddr " + (entry["to"].to_s.include?("/") ? "#{to}/#{to.prefix}" : to.to_s)
      raise "#{at}: use either port or ports" if entry.key?("port") && entry.key?("ports")
      ports = Array(entry["ports"] || entry["port"]).map do |port|
        from, upto = port.to_s.split("-", 2)
        valid = [from, upto || from].all? { |n| n =~ /\A\d+\z/ && n.to_i.between?(1, 65535) } && from.to_i <= (upto || from).to_i
        raise "#{at}: invalid port \"#{port}\" (1-65535 or a range like 8000-8100)" unless valid
        port.to_s
      end
      protocol = (entry["protocol"] || "tcp").to_s.downcase
      case protocol
      when "tcp", "udp"
        raise "#{at}: port or ports required for #{protocol} (all ports: 1-65535)" if ports.empty?
        "#{daddr} #{protocol} dport { #{ports.uniq.join(", ")} }"
      when "icmp", "all"
        raise "#{at}: protocol #{protocol} takes no ports" unless ports.empty?
        protocol == "all" ? daddr : "#{daddr} meta l4proto #{to.ipv4? ? "icmp" : "ipv6-icmp"}"
      else
        raise "#{at}.protocol: \"#{protocol}\" is not tcp, udp, icmp or all"
      end
    end

    dns = egress["dns"] == true
    accept = logged.include?("allowed") ? "goto allowed" : "accept"
    lines = ["table inet pods_egress", "delete table inet pods_egress", "table inet pods_egress {"]
    lines += ["  set dns4 { type ipv4_addr; }", "  set dns6 { type ipv6_addr; }"] if dns
    logged.each do |verdict|
      log_families.each do |family, _address, type|
        lines += ["  set #{verdict}#{family} { type #{type} . inet_proto . inet_service; size #{log_set_size}; flags dynamic; }",
                  "  set #{verdict}#{family}_noport { type #{type} . inet_proto; size #{log_set_size}; flags dynamic; }"]
      end
    end
    lines += [
      "  chain output {",
      "    type filter hook output priority filter; policy drop;",
      "    oifname \"lo\" accept",
      "    ct state established,related accept",
      "    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit } accept",
    ]
    lines += ["    ip daddr @dns4 meta l4proto { tcp, udp } th dport 53 #{accept}",
              "    ip6 daddr @dns6 meta l4proto { tcp, udp } th dport 53 #{accept}"] if dns
    lines += rules.map { |rule| "    #{rule} #{accept}" }
    # every blocked packet is recorded: it fails in the application, there is no connection to count it once
    lines += log_record.call("blocked").map { |rule| "    #{rule}" } if logged.include?("blocked")
    # a dropped SYN would leave connect() retrying for minutes, a reset fails it at once (other packets: EPERM)
    lines += ["    meta l4proto tcp counter reject with tcp reset", "    counter drop", "  }"]
    if logged.include?("allowed")
      # an allowed connection is recorded once, by its first packet: the conntrack mark skips the others still
      # in state new (e.g. TCP SYN retransmits, UDP datagrams of a flow without replies)
      lines += ["  chain allowed {", "    ct mark 0x1 accept", "    ct mark set 0x1"]
      lines += log_record.call("allowed").map { |rule| "    #{rule}" }
      lines += ["    accept", "  }"]
    end
    lines << "}"
    { "script" => lines.join("\n") + "\n", "dns" => dns, "rules" => rules.size, "log" => log }
  end

  host_path_prefixes = Array(p("pods.host_paths.allowed_prefixes")).map { |prefix| prefix.to_s.end_with?("/") ? prefix.to_s : "#{prefix}/" }
  # below an allowed prefix (never the prefix itself) and without ".." components
  allowed_host_path = lambda do |path|
    host_path_prefixes.any? { |prefix| path.start_with?(prefix) && path.length > prefix.length } && !path.split("/").include?("..")
  end

  definitions = (p("pods.definitions", {}) || {}).map do |name, definition|
    where = "pods.definitions.#{name}"
    raise "#{where}: invalid name, use [a-z0-9-] (max 50 characters)" unless name =~ /\A[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?\z/
    raise "#{where}: must be a hash" unless definition.is_a?(Hash)

    manifest = definition["manifest"]
    documents =
      case manifest
      when String then YAML.load_stream(manifest)
      when Hash then [manifest]
      when Array then manifest
      else raise "#{where}.manifest: required (hash, list of hashes or YAML string)"
      end
    documents = documents.compact
    documents.each_with_index do |doc, i|
      raise "#{where}.manifest[#{i}]: not a Kubernetes object (kind/metadata.name missing)" unless
        doc.is_a?(Hash) && doc["kind"] && doc.dig("metadata", "name")
    end

    kept, dropped = documents.partition { |doc| supported_kinds.include?(doc["kind"]) }
    stop_timeout = Integer(setting.call(definition, "stop_timeout"))

    pods = kept.select { |doc| pod_kinds.include?(doc["kind"]) }.map do |doc|
      object = "#{doc["kind"]}/#{doc["metadata"]["name"]}"
      if doc["kind"] == "Deployment"
        replicas = doc.dig("spec", "replicas") || 1
        raise "#{where}: #{object} has #{replicas} replicas, podman supports exactly 1" unless replicas.to_i == 1
      end
      # podman SIGKILLs a container after terminationGracePeriodSeconds, pod-ctl kills the whole teardown after
      # stop_timeout (+15s): a longer grace period would be cut short (and podman killed while holding its lock)
      spec = doc["kind"] == "Pod" ? doc["spec"] : doc.dig("spec", "template", "spec")
      grace = spec.is_a?(Hash) ? spec["terminationGracePeriodSeconds"] : nil
      if grace && Integer(grace) > stop_timeout
        raise "#{where}: #{object} terminationGracePeriodSeconds (#{grace}) exceeds stop_timeout (#{stop_timeout}), " \
              "the graceful stop would be cut short"
      end
      # podman names the pod of a Deployment/DaemonSet "<name>-pod"
      doc["kind"] == "Pod" ? doc["metadata"]["name"] : "#{doc["metadata"]["name"]}-pod"
    end
    raise "#{where}: the manifest contains no Pod, Deployment or DaemonSet" if pods.empty?
    raise "#{where}: duplicate pod names #{pods.inspect}" if pods.uniq.size != pods.size

    # hostPath directory ownership, applied by the supervisor before every `kube play`: the owner comes from
    # runAsUser/runAsGroup of the (init)containers mounting the directory read-write, or from host_path_owners.
    # Only paths below pods.host_paths.allowed_prefixes are ever touched.
    explicit_owners = (definition["host_path_owners"] || {}).map { |path, owner| [path.to_s.chomp("/"), owner.to_s] }.to_h
    owners = {} # path => { "owner" => "uid:gid", "create" => bool, "from" => container }
    if setting.call(definition, "fix_host_path_ownership")
      kept.select { |doc| pod_kinds.include?(doc["kind"]) }.each do |doc|
        spec = doc["kind"] == "Pod" ? doc["spec"] : doc.dig("spec", "template", "spec")
        next unless spec.is_a?(Hash)
        host_paths = {}
        Array(spec["volumes"]).each do |volume|
          host_path = volume["hostPath"]
          next unless host_path.is_a?(Hash) && ["", "Directory", "DirectoryOrCreate"].include?(host_path["type"].to_s)
          host_paths[volume["name"]] = { "path" => host_path["path"].to_s.chomp("/"), "create" => host_path["type"] == "DirectoryOrCreate" }
        end
        pod_context = spec["securityContext"] || {}
        (Array(spec["initContainers"]) + Array(spec["containers"])).each do |container|
          context = container["securityContext"] || {}
          uid = context["runAsUser"] || pod_context["runAsUser"]
          next if uid.nil?
          gid = context["runAsGroup"] || pod_context["runAsGroup"] || pod_context["fsGroup"] || uid
          owner = "#{Integer(uid)}:#{Integer(gid)}"
          Array(container["volumeMounts"]).each do |mount|
            host_path = host_paths[mount["name"]]
            next if mount["readOnly"] || host_path.nil? || !allowed_host_path.call(host_path["path"])
            path = host_path["path"]
            if owners[path] && owners[path]["owner"] != owner && !explicit_owners.key?(path)
              raise "#{where}: hostPath #{path} is mounted by containers running as #{owners[path]["owner"]} (#{owners[path]["from"]}) " \
                    "and #{owner} (#{container["name"]}), choose one with host_path_owners"
            end
            owners[path] = { "owner" => owner, "create" => host_path["create"], "from" => container["name"] }
          end
        end
      end
    end
    explicit_owners.each do |path, owner|
      raise "#{where}.host_path_owners: #{path} is not below #{host_path_prefixes.join(", ")}" unless allowed_host_path.call(path)
      raise "#{where}.host_path_owners.#{path}: \"#{owner}\" is not \"uid:gid\"" unless owner =~ /\A\d+:\d+\z/
      owners[path] = { "owner" => owner, "create" => true, "from" => "host_path_owners" }
    end

    play_flags = setting.call(definition, "play_flags")
    egress = definition["egress"].nil? ? nil : egress_rules.call("#{where}.egress", definition["egress"], kept, play_flags)

    header = ["# pods-boshrelease definition: #{name}"]
    header << "# dropped (unsupported by podman kube play): " + dropped.map { |d| "#{d["kind"]}/#{d["metadata"]["name"]}" }.join(", ") unless dropped.empty?
    kube = header.join("\n") + "\n" + kept.map(&:to_yaml).join

    env = <<~ENV
      POD_NAMES=#{bash_array.call(pods)}
      PLAY_FLAGS=#{bash_array.call(play_flags)}
      FOLLOW_LOGS=#{Shellwords.escape(setting.call(definition, "follow_logs").to_s)}
      WAIT_HEALTHY=#{Shellwords.escape(setting.call(definition, "wait_healthy").to_s)}
      START_TIMEOUT=#{Integer(setting.call(definition, "start_timeout"))}
      STOP_TIMEOUT=#{stop_timeout}
      POLL_INTERVAL=#{Integer(p("pods.supervisor.poll_interval"))}
      HOST_PATH_OWNERS=#{bash_array.call(owners.map { |path, o| "#{path}|#{o["owner"]}|#{o["create"]}" })}
      HOST_PATH_PREFIXES=#{bash_array.call(host_path_prefixes)}
      EGRESS_RULES=#{egress ? Shellwords.escape(egress["script"]) : "''"}
      EGRESS_DNS=#{egress && egress["dns"] ? "true" : "false"}
      EGRESS_LOG=#{egress ? egress["log"] : "none"}
    ENV

    { "name" => name, "kube" => kube, "env" => env, "pods" => pods, "dropped" => dropped.size, "owners" => owners, "egress" => egress }
  end
-%>
mkdir -p "$PODS_DEFS_DIR" "$PODS_RUN_DIR"
chmod 0700 "$(dirname "$PODS_DEFS_DIR")" "$PODS_DEFS_DIR"

<% if definitions.any? { |d| d["egress"] } -%>
# egress rules are loaded with the stemcell's nft into the pods' network namespaces
for tool in nft nsenter; do
  if ! command -v "$tool" > /dev/null 2>&1; then
    log_error "egress is configured but the $tool binary is missing on the stemcell"
    exit 1
  fi
done

<% end -%>

# write_definition <name> <kube.yml base64> <definition.env base64>
write_definition() {
  local dir="$PODS_DEFS_DIR/$1"
  mkdir -p "$dir" "$PODS_LOG_ROOT/$1"
  chmod 0700 "$dir"
  # manifests may contain Secrets
  (umask 077 && echo "$2" | base64 -d > "$dir/kube.yml.new" && echo "$3" | base64 -d > "$dir/definition.env.new")
  mv -f "$dir/kube.yml.new" "$dir/kube.yml"
  mv -f "$dir/definition.env.new" "$dir/definition.env"
}

DEFINITIONS=(<%= definitions.map { |d| d["name"] }.join(" ") %>)

<% definitions.each do |d| -%>
log_info "definition '<%= d["name"] %>': pods <%= d["pods"].join(", ") %><%= d["dropped"] > 0 ? " (#{d["dropped"]} unsupported object(s) dropped, see kube.yml header)" : "" %>"
<% d["owners"].each do |path, o| -%>
log_info <%= Shellwords.escape("definition '#{d["name"]}': hostPath #{path} owned by #{o["owner"]} (#{o["from"]})") %>
<% end -%>
<% if d["egress"] -%>
log_info "definition '<%= d["name"] %>': egress restricted to <%= d["egress"]["rules"] %> allow rule(s)<%= d["egress"]["dns"] ? " + DNS" : "" %>, connection log: <%= d["egress"]["log"] %>"
<% end -%>
write_definition <%= d["name"] %> \
  '<%= Base64.strict_encode64(d["kube"]) %>' \
  '<%= Base64.strict_encode64(d["env"]) %>'

<% end -%>
# Remove definitions that are no longer part of the deployment
# (their monit processes were already stopped by BOSH, `kube down` is a safety net; volumes are kept)
shopt -s nullglob
for dir in "$PODS_DEFS_DIR"/*/; do
  name=$(basename "$dir")
  if [[ " ${DEFINITIONS[*]} " != *" $name "* ]]; then
    log_info "removing definition '$name' (no longer in the manifest)"
    podman kube down "$dir/kube.yml" || log_warn "kube down of '$name' failed"
    rm -rf "$dir"
  fi
done

# operator command (`bosh ssh`, `sudo -i`, `pods`)
ln -sfn "$PODS_JOB_DIR/bin/pods" /usr/local/bin/pods
<% if p("pods.shell_profile") -%>
cat > /etc/profile.d/pods-bosh.sh << 'EOF'
if [ -n "${BASH_VERSION:-}" ]; then
  eval "$(/var/vcap/jobs/pods/bin/pods completion bash)"
fi
EOF
<% else -%>
rm -f /etc/profile.d/pods-bosh.sh
<% end -%>

log_info "--- ${SCRIPT_NAME} success"
