#!/usr/bin/env bash
set -euo pipefail

LOG_DIR=/var/vcap/sys/log/pods
mkdir -p "$LOG_DIR"

SCRIPT_NAME=$(basename "$0")
exec 1>> "${LOG_DIR}/${SCRIPT_NAME}.stdout.log"
exec 2>> "${LOG_DIR}/${SCRIPT_NAME}.stderr.log"

source /var/vcap/jobs/pods/bin/pods-env.sh

log_info "--- ${SCRIPT_NAME} begin"

# Fails the deploy when a definition does not become ready (running, and healthy when probes are defined)
failed=0
for name in <%= (p("pods.definitions", {}) || {}).keys.join(" ") %>; do
  pods_load_definition "$name"
  deadline=$((SECONDS + START_TIMEOUT))
  for pod in "${POD_NAMES[@]}"; do
    until pods_ready "$pod" "$WAIT_HEALTHY"; do
      if ((SECONDS >= deadline)); then
        log_error "'$name': pod '$pod' not ready within ${START_TIMEOUT}s"
        podman ps --all --filter "pod=$pod" --format '{{.Names}}: {{.Status}}' | while read -r line; do log_error "  $line"; done || true
        failed=1
        continue 2
      fi
      sleep 2
    done
    log_info "'$name': pod '$pod' is ready"
  done
done

if ((failed)); then
  log_error "--- ${SCRIPT_NAME} failed, see /var/vcap/sys/log/pods/<definition>/"
  exit 1
fi
log_info "--- ${SCRIPT_NAME} success"
