<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="pods BOSH release" id="id-ec747c2d65255a929882ee6feb5c06ef" version="5.0.0">
  <folder name="Strategy" id="id-8ce282d68cd351d187f5fad9d025efbd" type="strategy"/>
  <folder name="Business" id="id-663981d494ef56e6b1fd60d4767f3765" type="business">
    <element xsi:type="archimate:BusinessActor" name="Operator" id="id-425e89e6d1025ada9db645246e7f50e0">
      <documentation>Writes the BOSH deployment manifest and operates the instances (bosh deploy, bosh ssh + pods command).</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-75f33e3755ca53ae84c01b68a6a0fdd7" type="application"/>
  <folder name="Technology &amp;amp; Physical" id="id-543623671f765346b0b1f733cb0e225e" type="technology">
    <element xsi:type="archimate:Artifact" name="BOSH manifest: Kubernetes YAML in pods.definitions" id="id-e38b05f01f07582bbc67bdd014680fc1">
      <documentation>Kubernetes YAML per definition: Pod, Deployment, DaemonSet (1 replica), ConfigMap, Secret, PersistentVolumeClaim - a hash, a list of hashes or a multi-document string (e.g. helm template output). Credhub variables ((name)) can be used anywhere.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="BOSH Director + CredHub" id="id-fe81064e95b75a03b53141b5072ab497">
      <documentation>Renders the job templates, resolves ((variables)), runs the lifecycle hooks on the VM.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="BOSH VM – ubuntu-noble stemcell (cgroup v2)" id="id-d9f88039c8e55870ad70d2aedcddf397">
      <documentation>Instance of the deployment. Requires an ubuntu-noble stemcell: Podman 6 dropped cgroup v1.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="monit (BOSH process supervisor)" id="id-9c915cd60ded5c0fbc93d3651530ffef">
      <documentation>Monit processes: pod-&lt;definition> (one per definition), podman-exporter-api, podman-exporter, podman-api.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyProcess" name="BOSH lifecycle: pre-start, post-start, drain" id="id-c8d17ccdaa0b53c5a7480d000dd1eb5d">
      <documentation>pre-start validates the definitions and writes kube.yml; post-start fails the deploy unless every pod is running (and healthy) within start_timeout; drain stops the definitions gracefully, dependents first.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="kube.yml per definition" id="id-2e3b559b36985f02b319d0f5b0587495">
      <documentation>/var/vcap/data/pods/definitions/&lt;definition>/kube.yml (mode 0600, may contain Secrets).</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="pods CLI (operator command)" id="id-60206463b2fe5a70986dcfb420725d9b">
      <documentation>/usr/local/bin/pods: kubectl-like view of the definitions on top of podman, monit and the job's files - status, logs, exec, describe, egress, restart.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Logs (container output, egress.log)" id="id-7a59f0d81ed955e39f661657f36e3704">
      <documentation>/var/vcap/sys/log/pods/&lt;definition>/: container output (CRI format), egress.log (connection log), supervisor and pod-ctl logs; rotated by the stemcell logrotate, collected by bosh logs and syslog forwarders.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="pod-supervisor (one per definition)" id="id-eb321b1a20535e449e59f366c852e28c">
      <documentation>Monit process pod-&lt;definition>. podman kube play --replace; loads the egress nftables rules before any container starts; polls podman ps (pod gone -> exit -> monit replays it); follows container logs; runs liveness/startup probes; podman kube down on stop (named volumes kept).</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Podman configuration: containers, storage, registries, policy, auth" id="id-f83b9c3707235d83bc312e65eb83b07b">
      <documentation>containers.conf, storage.conf, registries.conf, policy.json, auth.json linked into /etc/containers. Generated from properties, extendable with podman.raw_config.* (deep-merged).</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="podman-exporter-api (podman API service)" id="id-0e43c882e9ab5b15bc9b60696f92df46">
      <documentation>podman system service on the root-only unix socket /var/vcap/sys/run/podman-exporter/api/podman.sock.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="podman-exporter" id="id-01c6cc007c425eba8114ef31a970e1ee">
      <documentation>prometheus-podman-exporter in remote (API client) mode - no podman libraries and locks of its own.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyInterface" name=":9882/metrics" id="id-6ca6f89a56135059ae75158cb5d3e46a">
      <documentation>Prometheus endpoint (podman_exporter.port, podman_exporter.telemetry_path).</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="podman-api (podman API service for pods)" id="id-1a9f657412f549c599757712bc717594">
      <documentation>podman system service (libpod and Docker-compatible REST API) on &lt;podman_api.socket_dir>/podman.sock (default /var/vcap/sys/run/podman-api). Root only (0700 / 0600), or one group with podman_api.group_gid (directory 0750, socket 0660). Clients in pods (CI/workflow engines, podman --remote, docker CLI) mount the directory as a hostPath. Root-equivalent: dedicated instances, trusted clients only. Containers it starts are outside the pods definitions (no supervisor, egress rules, log copy).</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Podman 6 engine (podman-static): podman, conmon, crun / runc, netavark, aardvark-dns, pasta" id="id-5ae4d0c465775f86b55d1f8b5ed551db">
      <documentation>Daemonless container engine from mgoltzsche/podman-static. Storage under podman.data_dir (persistent disk if present).</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Pod (one per definition)" id="id-73e631eff7a15d7f8735ec4ea336adc4">
      <documentation>Created by podman kube play from the definition's kube.yml.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Containers (restartPolicy, probes)" id="id-72ddc97229fb56a2bdf8737902f2123f">
      <documentation>Restarts are handled by podman/conmon; a failing livenessProbe restarts the container.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyFunction" name="Egress allowlist: nftables in the pod netns, default drop" id="id-1acf8bddc91e57638d219d9501d997d5">
      <documentation>Table inet pods_egress (output hook) in each pod's network namespace, loaded by the supervisor before any container starts. Everything not listed is blocked.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyInterface" name="hostPort" id="id-129b8f8790e5564b927f113a340aa9f7">
      <documentation>Ports published on the VM. Inbound traffic is not filtered.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Persistent data (hostPath under /var/vcap/store, PVC = podman named volume)" id="id-41fb5513f8195014ba69f20974f28246">
      <documentation>hostPath ownership is handled by the release (DirectoryOrCreate, chown for runAsUser). PVC volumes are never removed by the release.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Prometheus + Grafana (docs/dashboard.json)" id="id-63eb3eaff32e5bc882f1a30adc4b12af">
      <documentation>Scrapes the exporter (interval >= 30s); Grafana dashboard shipped in docs/dashboard.json.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Container registries (docker.io, mirrors)" id="id-59fcfe7c5f2555399d3e4f5c19c08aac">
      <documentation>podman.registries: unqualified_search, insecure, mirrors, auth, policy.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Allowed destinations (IP / CIDR, protocol, ports)" id="id-bfb77422cc9b5f9f9dbfc436b1a5fa8b">
      <documentation>Only the egress.allow entries (and DNS with dns: true) are reachable.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Clients: any host that can reach the VM IP" id="id-012a25a6650e588fb484198409ed6a29">
      <documentation>Who can use the services published with hostPort. Inbound traffic is not filtered: any host with a route to the VM IP (other VMs, other networks). Other pods on the same VM only when their egress.allow lists the VM IP.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-0ad7fe8fbcbb5acca5ff5313c897461e" type="motivation"/>
  <folder name="Implementation &amp;amp; Migration" id="id-70c719538eba554eaede8de9612ffe22" type="implementation_migration"/>
  <folder name="Other" id="id-0700c1358659532887df4922e2d9ae6a" type="other">
    <element xsi:type="archimate:Grouping" name="job: pods" id="id-b59d048a29d351bfb0dc73ec18c7089b">
      <documentation>Runs the Kubernetes YAML definitions: one monit process pod-&lt;name> each.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="job: podman" id="id-9e9db9bf9ca85c9581c3b0bff0ef9c58">
      <documentation>Podman engine configuration (no process).</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="job: podman-exporter" id="id-1216de33be9b5c3db9b747c6d105f89a">
      <documentation>Prometheus metrics of containers, pods, images and volumes, read via the podman API.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="job: podman-api" id="id-914420b6b14ef302a129d1549fe0bd4f">
      <documentation>Podman API service on a unix socket for clients running in pods. Requires the podman job.</documentation>
    </element>
  </folder>
